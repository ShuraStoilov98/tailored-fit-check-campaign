# Required in production. Leave blank locally to run in mock mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Where the "Download Tailored" CTA points.
APP_STORE_CTA_URL=https://go.tailored-to-you.com/try

# Google Sheet webhook for events and leads. Blank = logging no-ops.
GOOGLE_SHEET_WEBHOOK_URL=

ENVIRONMENT=local
MAX_UPLOAD_MB=5

# Abuse protection (per client, per window).
FIT_CHECK_RATE_LIMIT=8
LEAD_RATE_LIMIT=5
EVENT_RATE_LIMIT=60
RATE_LIMIT_WINDOW_SECONDS=60

# Per-process limits across all clients, in the same window.
API_GLOBAL_RATE_LIMIT=240
FIT_CHECK_GLOBAL_RATE_LIMIT=40

# Enable ONLY behind Railway's public HTTP ingress, which supplies X-Real-IP.
# Keep false for local development and directly accessible servers.
# Run Uvicorn with --no-proxy-headers in either case.
TRUST_RAILWAY_PROXY=false
